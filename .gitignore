# ---- 环境变量与密钥（务必不要提交）----
.env
*.env.local

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# ---- 本地数据库 ----
*.db
*.db-journal

# ---- Node / 前端 ----
node_modules/
web/dist/

# ---- 部署产物与自签证书 ----
deploy/certs/*.crt
deploy/certs/*.key
deploy/backup/*.sql
deploy/backup/*.dump
deploy/backup/*.gz
# 备份脚本默认输出目录（BACKUP_DIR 默认 ./backups），防止备份文件被误提交
/backups/

# 数据质量巡检台账（脚本生成，防止误提交）
backend/data_quality_review*.csv

# 采集原始页面快照（运行时产物，保留在本地，不入库）
backend/snapshots/

# ---- 日志与系统文件 ----
*.log
.DS_Store
Thumbs.db
