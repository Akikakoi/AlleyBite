# 复制为 .env（docker compose 会自动加载）后按需修改；.env 请勿提交到版本库。
# 密钥留空时：LLM 自动走 mock 模式（可离线跑通），高德源跳过。

# --- 调试开关 ---
# 本地非容器直跑用；容器部署由 docker-compose 固定 DEBUG=false。
# 生产（DEBUG=false）会启用弱密钥强校验与 CORS 收紧。
DEBUG=true

# --- PostgreSQL（文档 10.2）---
POSTGRES_USER=alleybite
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alleybite

# --- CORS 白名单（文档 10.2）：仅放行前端域名，逗号分隔 ---
# 例：CORS_ORIGINS=https://alleybite.example.com
CORS_ORIGINS=

# --- LLM（OpenAI 兼容协议）---
LLM_PROVIDER=dashscope
LLM_MODEL=qwen-plus
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- 高德地图开放 API（POI 实体基准，文档 4.1）---
AMAP_API_KEY=
AMAP_KEYWORDS=美食,川菜,火锅,面馆,烧烤,小吃,家常菜,串串

# --- 采集（文档 4.3）：真实可联系的联系方式，用于拼 User-Agent，上线前务必填写 ---
CRAWL_CONTACT=
CRAWL_RSS_URLS=
CRAWL_HTML_LIST_URLS=

# --- 调度器（文档 4.4）---
SCHEDULE_ENABLED=true
# 留空则由数据库自动读取城市列表
SCHEDULE_CITIES=

# --- 监控与告警（文档 10.4）---
# 飞书自定义机器人 webhook；留空则告警仅打印到 alert-bridge 日志
FEISHU_WEBHOOK_URL=
# Grafana 管理员密码（仅回环端口 3000 可达，建议经 SSH 隧道访问）
GRAFANA_ADMIN_PASSWORD=change-me
# 对外访问基址，用于 Grafana 子路径 root_url；经 nginx 访问时填真实域名
# 同时作为分享页 og 元信息的基址（SHARE_BASE_URL），留空则按请求头推导
PUBLIC_BASE_URL=https://localhost

# --- 分享预览与纠错（文档 9.4 / 9.3）---
# 默认分享图：相对路径基于对外基址，也可直接填绝对 URL（如自有 CDN 图）
SHARE_OG_IMAGE=/og-default.jpg
# 纠错提交限流：单 IP 每窗口（默认 60 分钟）最多条数
FEEDBACK_RATE_LIMIT_MAX=5
# IP 哈希加盐；生产（DEBUG=false）必须改为长度 ≥ 16 的随机串，否则 API 拒绝启动
FEEDBACK_IP_SALT=change-me

# --- 管理后台（文档 9.5）：独立登录 + 独立入口，仅内网/白名单可访问 ---
# 首次启动用于初始化超管（幂等）；留空则不自动建号，改用 backend/scripts/create_admin.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 令牌签名密钥：留空则回退到 FEEDBACK_IP_SALT；生产（DEBUG=false）必须为长度 ≥ 16 的随机串
ADMIN_TOKEN_SECRET=change-me
# 令牌有效期（分钟）
ADMIN_TOKEN_TTL_MINUTES=120
# 管理后台独立入口：域名与 HTTPS 端口（建议仅内网 DNS 解析/白名单可达）
ADMIN_SERVER_NAME=admin.localhost
ADMIN_HTTPS_PORT=8443