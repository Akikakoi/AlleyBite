# 复制为 .env 后按需修改。若无 LLM_API_KEY，系统自动走 mock 模式（离线可跑）。

APP_NAME=AlleyBite API
DEBUG=true
# CORS 白名单（文档 10.2），逗号分隔；留空时 debug 全放行、生产不放行
# 例：CORS_ORIGINS=https://alleybite.example.com,https://staging.alleybite.example.com
CORS_ORIGINS=

# LLM 配置（OpenAI 兼容协议）
# provider: dashscope | deepseek | openai
LLM_PROVIDER=dashscope
LLM_MODEL=qwen-plus
LLM_API_KEY=
# 各 provider 的 OpenAI 兼容 base_url
#   dashscope: https://dashscope.aliyuncs.com/compatible-mode/v1
#   deepseek : https://api.deepseek.com/v1
#   openai   : https://api.openai.com/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 强制使用 mock（离线演示/单测用）
LLM_MOCK=false
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.1

# 抽取
EXTRACT_CONFIDENCE_MIN=0.6
EXTRACT_JSON_RETRY=3

# 清洗与切块（文档 5.2）
EXTRACT_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=0
MIN_CHINESE_RATIO=0.5

# 打分模型（文档 6）
SCORE_TIME_HALF_LIFE_DAYS=180
SCORE_MENTION_TARGET=8
SCORE_CONFIDENCE_TARGET=3
SCORE_SPAN_TARGET_DAYS=365
SCORE_UNIQUENESS_TARGET=2
SCORE_PARADOX_TARGET=1
SCORE_PRICE_CEILING=150
SCORE_INFLUENCER_TARGET=3
SCORE_HYGIENE_TARGET=3
# 硬规则（6.3）
SCORE_AD_EXCLUDE_RATIO=0.4
SCORE_BURST_WINDOW_DAYS=7
SCORE_BURST_MIN_MENTIONS=20
SCORE_CHAIN_CATEGORIES=购物中心内,连锁快餐
CHAIN_BRAND_BLACKLIST=

# 实体对齐（文档 5.5）
ALIGN_MATCH_THRESHOLD=0.85
ALIGN_REVIEW_THRESHOLD=0.65
ALIGN_NAME_WEIGHT=0.7
ALIGN_ADDRESS_WEIGHT=0.3

# 榜单缓存（文档 6.4 第 6 步）；留空则降级为直读库内快照
REDIS_URL=
RANK_CACHE_TTL=3600

# 采集（文档第 4 章）
CRAWL_QPS_PER_DOMAIN=1
CRAWL_JITTER_MIN=0.5
CRAWL_JITTER_MAX=2
CRAWL_NIGHT_PAUSE=true
CRAWL_NIGHT_START=23
CRAWL_NIGHT_END=7
CRAWL_RETRY_MAX=3
CRAWL_TIMEOUT=20
# 真实可联系的联系方式（邮箱/主页），用于拼 User-Agent；上线前务必填写
CRAWL_CONTACT=
# 显式指定 User-Agent；留空则由 CRAWL_CONTACT 派生
CRAWL_USER_AGENT=
# 公开 RSS/Atom feed 与公开列表页（逗号或换行分隔）；留空则对应源 skipped
CRAWL_RSS_URLS=
# 列表页模式：页面内同域外链 → 逐条跟进正文
CRAWL_HTML_LIST_URLS=
# 单页即内容模式：页面正文整体作为一条内容，不跟进外链；适用于官方名单/榜单静态页
# 每项格式 `城市=URL`（无前缀时用 --city 指定城市）。示例（广州文旅局 2026 老字号名单）：
#   广州=https://wglj.gz.gov.cn/gkmlpt/content/11/11014/post_11014603.html
CRAWL_HTML_PAGE_URLS=
CRAWL_MAX_ITEMS_PER_SOURCE=200
CRAWL_BREAKER_FAIL_THRESHOLD=5
CRAWL_BREAKER_COOLDOWN_MINUTES=360
SNAPSHOT_DIR=./snapshots
CRAWL_SNAPSHOT_TTL_DAYS=90

# 高德地图开放 API（POI 实体基准）；留空则跳过高德源
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com/v3/place/text
AMAP_PAGE_SIZE=20
AMAP_MAX_PAGES=3
AMAP_KEYWORDS=美食,川菜,火锅,面馆,烧烤,小吃,家常菜,串串

# 数据库：本地 SQLite，生产用 PostgreSQL 15
#   sqlite:///./alleybite.db
#   postgresql+psycopg://user:pass@localhost:5432/alleybite
DATABASE_URL=sqlite:///./alleybite.db
DB_ECHO=false