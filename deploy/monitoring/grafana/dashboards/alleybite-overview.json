{
  "uid": "alleybite-overview",
  "title": "AlleyBite 运营总览（文档 10.4）",
  "tags": ["alleybite"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API 抓取状态",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "alleybite-prometheus" },
      "targets": [
        { "refId": "A", "expr": "up{job=\"alleybite-api\"}", "instant": true }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "抽取失败率",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "alleybite-prometheus" },
      "targets": [
        { "refId": "A", "expr": "alleybite_extract_failure_ratio", "instant": true }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "red", "value": 0.05 } ] } },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "去重率",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "alleybite-prometheus" },
      "targets": [
        { "refId": "A", "expr": "alleybite_dedup_ratio", "instant": true }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "无地址率",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "alleybite-prometheus" },
      "targets": [
        { "refId": "A", "expr": "alleybite_mention_missing_address_ratio", "instant": true }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 0.2 } ] } },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "24h 新增 mention",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "alleybite-prometheus" },
      "targets": [
        { "refId": "A", "expr": "alleybite_mention_new_24h", "instant": true }
      ],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "熔断中的源",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "alleybite-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(alleybite_crawl_breaker_open)", "instant": true }
      ],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "各源采集成功率",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "alleybite-prometheus" },
      "targets": [ { "refId": "A", "expr": "alleybite_crawl_success_ratio" } ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "403 / 429 比例",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "alleybite-prometheus" },
      "targets": [
        { "refId": "A", "expr": "alleybite_crawl_http_403_ratio", "legendFormat": "403 {{source}}" },
        { "refId": "B", "expr": "alleybite_crawl_http_429_ratio", "legendFormat": "429 {{source}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "HTTP QPS（按状态码）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "alleybite-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(alleybite_http_requests_total[5m]))", "legendFormat": "{{status}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "API P95 延迟",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "alleybite-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(alleybite_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "P95"
        },
        {
          "refId": "B",
          "expr": "sum(rate(alleybite_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(alleybite_http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx 错误率"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "成本：近 24h LLM token / 高德调用",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "alleybite-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (alleybite_llm_tokens_24h)",
          "legendFormat": "LLM {{kind}}"
        },
        {
          "refId": "B",
          "expr": "alleybite_amap_requests_24h",
          "legendFormat": "amap 请求数"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
